config_version=5

[application]
config/name="SandboxAI Tactical Arena"
config/description="Controlled tactical FPS environment for SandboxAI learning."
run/main_scene="res://scenes/Arena.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]
RLBridge="*res://scripts/rl_bridge.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/size/initial_width=1280
window/size/initial_height=720

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[debug]
settings/fps/force_fps=120
