; SandboxAI project configuration
; Godot 4.7.2

config_version=5

[application]

config/name="SandboxAI"
config/description="SandboxAI: a Godot-based reinforcement-learning training simulator for a minimal 3D FPS combat environment."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
; The JSON-lines RL bridge (scripts/rl/rl_server.gd) replies over stdout via
; print(); without this, release/export builds buffer stdout and the Python
; trainer deadlocks waiting for a response line.
run/flush_stdout_on_print=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[rendering]

renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.08, 1)
